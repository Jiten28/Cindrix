# Environment
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Real runtime logs & memory (examples/ folder is the only committed copy)
chat.log
conv_history.json
*.log

# App data — all local/regenerable, created automatically at runtime
data/chat_logs/
data/uploads/
data/embeddings/
data/cache/
data/conversations/

# RAG index — build output from ingest.py, but committed on purpose: it's the
# app's knowledge base, and a deployed container can't rebuild it (needs the
# 3.7 GB dataset shard plus a full embedding-quota run). Lives outside data/ so
# a mounted runtime volume can't shadow it.

# Sensitive data — never commit these
data/conv_history.json
data/analytics_events.json
data/users.json

# Hugging Face dataset cache, if it ever ends up inside the repo dir
# instead of the user-level ~/.cache (ingest now uses huggingface_hub +
# pyarrow, which caches downloaded shards)
.cache/
.huggingface/
huggingface/
*.parquet

# Test & tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build / submission artifacts (e.g. a zipped copy of the repo)
*.zip

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/