# Environment
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Real runtime logs & memory (examples/ folder is the only committed copy)
chat.log
conv_history.json
*.log

# App data — all local/regenerable, created automatically at runtime
data/chat_logs/
data/uploads/
data/embeddings/
data/cache/
data/conversations/

# RAG index — generated by ingest.py, regenerable from the dataset,
# not meant to live in git (binary, large, and rebuilds on demand).
# Includes the latency benchmark report, which is also just local
# run output, not source.
data/rag_index/

# Sensitive data — never commit these
data/conv_history.json
data/analytics_events.json
data/users.json

# Hugging Face dataset cache, if it ever ends up inside the repo dir
# instead of the user-level ~/.cache (ingest now uses huggingface_hub +
# pyarrow, which caches downloaded shards)
.cache/
.huggingface/
huggingface/
*.parquet

# Test & tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build / submission artifacts (e.g. a zipped copy of the repo)
*.zip

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/