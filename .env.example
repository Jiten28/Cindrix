# Google API Key — powers Gemini chat, image/document understanding (vision),
# and the embeddings behind every retrieval call. Also the FALLBACK generation
# provider — see GROQ_API_KEY below and docs/Architecture.md's "Generation
# Provider Chain" section. Required either way.
GOOGLE_API_KEY=

# Groq API Key — the PRIMARY generation provider for RAG-serving calls
# (document_rag / knowledge_base_rag), Gemini above is the fallback if
# Groq exhausts its retries. Strongly recommended: without it, every RAG
# call falls straight to Gemini (a warning is logged at startup, not a hard
# failure). Get a key at console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tavily API key — powers BOTH general web search ("search for X") and image
# search ("image of X"). Without it both tools return a graceful "search isn't
# configured" message; nothing else is affected. Free tier: 1,000
# credits/month, no credit card required. Get one at tavily.com.
TAVILY_API_KEY=

# Session signing key. If left blank, a random one is
# generated each time the server starts, meaning logged-in sessions won't
# survive a restart. Set a real fixed value before deploying anywhere real —
# any long random string works, e.g. generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Emails that are always treated as admin, regardless of signup order.
# Comma-separated if you want more than one. Leave blank to just rely on
# "first account ever created is admin" instead.
ADMIN_EMAILS=

# --- Speech-to-text ---
# Sarvam is the real provider and the default whenever SARVAM_API_KEY is set.
# Force "webspeech" to use the browser-native Web Speech API instead — no key,
# but Chrome/Edge only and the audio goes to the browser vendor, not your
# server. Leave STT_PROVIDER unset unless you specifically want that.
# STT_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
# "unknown" auto-detects the spoken language.
SARVAM_STT_LANGUAGE=unknown

# --- RAG / vector store ---
RAG_DATASET_NAME=ai4bharat/MSMARCO-XI
RAG_DATASET_LANGUAGE=hi
RAG_DATASET_SPLIT=train
# Rows pulled from the dataset shard per ingest run. The cap is Gemini's
# free-tier embedding quota (~1000 contents/day), not the download — 75 rows
# is ~870 chunks. Raise it on a paid tier.
RAG_INGEST_MAX_ROWS=75
# Outside data/ on purpose: data/ is the mutable runtime volume, and a hosted
# persistent disk mounted there would shadow the index shipped in the image.
RAG_INDEX_DIR=rag_index
# Cosine bands for the knowledge-base decision, calibrated against the built
# index (see docs/Architecture.md). At/above MIN_RELEVANCE the answer comes
# strictly from retrieved excerpts; between the two the system declines rather
# than answer from a weak match; below DECLINE_FLOOR the corpus isn't about the
# question at all, so it's answered conversationally instead.
RAG_MIN_RELEVANCE=0.73
RAG_DECLINE_FLOOR=0.70

